# Copy to .env (never commit .env). Without these two values the app runs in local demo mode.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Login names are turned into e-mails for Supabase Auth: <username>@<this domain>
VITE_AUTH_EMAIL_DOMAIN=btech.local
# Web Push (optional): public half of the key pair from `npx web-push generate-vapid-keys`.
# The private half goes to the send-push edge function via `supabase secrets set`.
VITE_VAPID_PUBLIC_KEY=
